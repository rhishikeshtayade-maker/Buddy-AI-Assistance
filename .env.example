# ==============================================================================
# BUDDY — Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES.
# NEVER COMMIT .env OR REAL SECRETS TO VERSION CONTROL!
# ==============================================================================

# Application Environment
BUDDY_ENV=development                    # development | production | testing
BUDDY_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
BUDDY_DATA_DIR=data                      # Local data directory for BUDDY

# Security & Authentication
BUDDY_AUTH_PIN_SALT=                     # Auto-generated during initial security setup
BUDDY_MASTER_KEY_STORAGE=keyring         # keyring | local_vault
BUDDY_CONFIRMATION_TIMEOUT_SEC=30        # Confirmation prompt window in seconds
BUDDY_MAX_AUTH_ATTEMPTS=5                # Rate-limiting lockout threshold

# AI Provider Configuration
BUDDY_AI_PROVIDER=mock                   # mock | openai | anthropic | gemini | local
BUDDY_AI_MODEL=mock-v1
BUDDY_AI_API_KEY=                        # Leave empty when using OS Credential Vault
BUDDY_AI_TEMPERATURE=0.2
BUDDY_AI_MAX_TOKENS=2048

# Voice Pipeline Configuration
BUDDY_WAKE_WORD=hey buddy
BUDDY_STT_PROVIDER=mock                  # mock | whisper_local | system
BUDDY_TTS_PROVIDER=mock                  # mock | pyttsx3 | system
BUDDY_AUDIO_INPUT_DEVICE=default
BUDDY_AUDIO_OUTPUT_DEVICE=default
BUDDY_VAD_SENSITIVITY=2                  # 1 (low) to 3 (aggressive)

# Computer Control & Safety Bounds
BUDDY_ALLOWED_APP_DIRS=C:\Program Files,C:\Program Files (x86),C:\Windows\System32
BUDDY_RESTRICTED_DIRS=C:\Windows,C:\Windows\System32\drivers,C:\Recovery
BUDDY_DEVELOPER_MODE=false
BUDDY_ALLOW_AUTOMATION=true
BUDDY_AUDIT_LOG_ENABLED=true
